# Database Connector MCP Service - Environment Variables

# Python module search path
PYTHONPATH=/app/mcp-servers

# Path to databases.yaml configuration file
DB_CONFIG_PATH=/app/mcp-servers/config/databases.yaml

# Base path for metadata documents (Information.json etc.)
METADATA_BASE_PATH=/app/mcp-servers

# Default root directory for CSV data output
DATA_OUTPUT_ROOT=/app/data

# PostgreSQL connection URLs
# Format: postgresql://{username}:{password}@{host}:{port}/{database}
CDM_DATABASE_URL=postgresql://user:password@localhost:5432/cdm
KMIMIC_DATABASE_URL=postgresql://user:password@localhost:5432/kmimic
MIMICIV_DATABASE_URL=postgresql://user:password@localhost:5432/mimiciv
INSPIRE_DATABASE_URL=postgresql://user:password@localhost:5432/inspire
SYNTHEA_DATABASE_URL=postgresql://user:password@localhost:5432/synthea
