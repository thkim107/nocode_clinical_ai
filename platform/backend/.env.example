# ---- Chat (MCP Workspace tab) ----
# OpenRouter is used by the chatbot; the same key is reused by the research
# LLM manager when LLM_DEFAULT_PROVIDER=openrouter.
OPENROUTER_API_KEY=
CHAT_MODEL=anthropic/claude-sonnet-4-6
OPENROUTER_MODEL=anthropic/claude-sonnet-4-6

# ---- Research (Planner / PubMed / IRB tabs) ----
PROMPT_LANG=en                      # ko | en
APP_VERSION=local
PROMPT_VERSION=unknown              # bump when prompts or study protocol change
TELEMETRY_HMAC_KEY=                 # stable random secret; hashes user_code before DB storage
TELEMETRY_VIEWER_TOKEN=              # stable random admin token for viewer and CSV export
LLM_DEFAULT_PROVIDER=openrouter     # openai | anthropic | openrouter | snuhllm
LLM_DEFAULT_MODEL=anthropic/claude-sonnet-4-6
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SNUHLLM_API_KEY=
SNUHLLM_BASE_URL=http://localhost:8000/v1
SNUHLLM_MODEL=default

# ---- Infrastructure ----
MCP_ROUTER_URL=http://router:8000
MCP_TIMEOUT=600
OPENROUTER_TIMEOUT=600
MAX_TOOL_ITERATIONS=20
# AUDIT_DB_URL is injected by docker-compose.
# DATA_DIR=/app/data   shared volume (volume_storage)
# STATE_DIR=/app/state platform-private state (session store)
